#include <stdio.h>

void draw_square(int size);

int main(void)
{
    int n;
    printf("정사각형 그리기\n\n");
    printf("정사각형의 길이(최대 37)를\n");
    printf("입력하고 Enter>");
    scanf("%d", &n);
    
    // 입력값 범위 예외 처리 (선택사항)
    if (n < 1 || n > 37) {
        printf("1부터 37 사이의 값을 입력해주세요.\n");
        return 1;
    }
    
    draw_square(n);
    return 0;
}

void draw_square(int size)
{
    int i, j;
    unsigned char a = 0xa6;
    unsigned char b[7]; 
    
    // b 배열 인덱스 0부터 시작하도록 정리 (b[0]~b[5])
    for(i = 0; i < 6; i++)
        b[i] = 0xa1 + i;
    
    // 상단 테두리 
    printf("%c%c", a, b[2]); // 좌상단 모서리
    for(i = 0; i < size; i++)
        printf("%c%c", a, b[0]); // 상단 가로 선
    printf("%c%c", a, b[3]); // 우상단 모서리
    printf("\n");
    
    // 내부 공백 및 좌우 테두리
    for(i = 0; i < size; i++)
    {
        printf("%c%c", a, b[1]); // 좌측 세로 선
        
        // 박스 문자의 가로 폭(2칸)을 고려해 공백을 size * 2 개 출력
        for(j = 0; j < size * 2; j++)
            printf(" ");
            
        printf("%c%c", a, b[1]); // 우측 세로 선
        printf("\n");
    }
    
    // 하단 테두리
    printf("%c%c", a, b[5]); // 좌하단 모서리
    for(i = 0; i < size; i++)
        printf("%c%c", a, b[0]); // 하단 가로 선
    printf("%c%c", a, b[4]); // 우하단 모서리
    printf("\n");
}